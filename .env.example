# ─── ZANPOS Environment Variables ─────────────────────────────────────────────
# Copy this file to `.env` and fill in values as needed. None are required for a
# basic local build — they configure optional dev/release features.

# ── Tauri dev server ──────────────────────────────────────────────────────────
# Set to your machine's LAN IP to test the dev build on other devices on the network.
# Leave blank for normal localhost development.
TAURI_DEV_HOST=

# ── Tauri updater signing (release builds only) ───────────────────────────────
# Generated with: npx tauri signer generate -w ./zanpos.key
# The PRIVATE key + its password are required to sign auto-updater release artifacts.
# NEVER commit these. The matching PUBLIC key lives in src-tauri/tauri.conf.json.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# The following are NOT environment variables — they are entered at runtime
# through the app UI and stored securely (OS credential store / encrypted SQLite).
# Listed here for developer awareness only:
#
#   • Supabase URL + service role key  → Settings → Cloud Sync (OS credential store)
#   • Supabase Personal Access Token   → Setup wizard, used once for schema migration
#   • Anthropic / OpenAI API keys       → Back Office → AI (OS credential store)
#   • WhatsApp pairing                  → Settings → WhatsApp (QR scan, no key needed)
#   • Thermal printer COM port / baud   → Settings → Printers
# ─────────────────────────────────────────────────────────────────────────────
