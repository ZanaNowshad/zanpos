node_modules/
dist/
src-tauri/target*/
src-tauri/binaries/
src-tauri/sidecar/whatsapp-sidecar/node_modules/
src-tauri/sidecar/whatsapp-sidecar/node.exe
*.log
.env
.sidecar_token
.npm-cache/
src-tauri/.npm-cache/
src-tauri/src/.npm-cache/
src-tauri/sidecar/**/.npm-cache/
# Repo Cognition layer — derived state with machine-specific paths.
# Remove this line to commit it and share architectural memory with the team.
.repo-cognition/

# Agent tooling scratch state — machine-local, regenerated on demand.
.claude-flow/
.superpowers/
.zcode/
.claude/proven-config.json
.claude/.proven-config-version

# QA screenshots. The harness scripts (qa/*.mjs) are committed; the images they
# produce are build output — a few hundred PNGs that churn on every run.
qa/layout/
qa/parity/
qa-artifacts/
# Matched by shape, not by name — a key generated as `zanpos-updater-2026.key`
# fell through the old exact-name rule and was staged for commit.
*.key
*.key.pub
*.pem

# Playwright run state — regenerated on every run.
storefront/test-results/

# Vitest coverage output — regenerated by `npm run coverage`.
coverage/

# Python bytecode. The semgrep contract validator is a security control;
# a checked-in .pyc can be loaded in place of the reviewed .py.
__pycache__/
*.py[cod]
