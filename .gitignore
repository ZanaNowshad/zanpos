# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# npm cache (placed in-project by some tools)
.npm-cache/

# Tauri build output
src-tauri/target/

# Tauri generated schemas (regenerated at build time)
src-tauri/gen/

# Test coverage reports
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local environment overrides (never commit secrets)
.env
.env.local
.env.*.local

# Sidecar compiled binaries (built locally via pkg)
src-tauri/binaries/*.exe

# Database files — never commit POS data
*.db
*.db-journal
*.db-wal

# S-04: WhatsApp session + sidecar auth token — never commit credentials
wa-session/
**/wa-session/
*.sidecar_token
.sidecar_token
*.db-shm
*.sqlite
*.sqlite3
*.db3
*.s3db
*.bak
zanpos*.db*
src-tauri/zanpos*.db*

# Certificates and keys
*.pem
*.p12
*.pfx
*.key
id_rsa*
id_ed25519*
id_ecdsa*
*.key.pub
*.crt
