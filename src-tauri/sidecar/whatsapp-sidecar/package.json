{
  "name": "whatsapp-sidecar",
  "version": "1.0.0",
  "description": "ZANPOS WhatsApp sidecar — Baileys HTTP bridge",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "bundle": "esbuild server.js --bundle --platform=node --format=cjs --target=node20 --outfile=bundle.cjs --external:bufferutil --external:utf-8-validate",
    "build": "npm run bundle && pkg bundle.cjs --target node20-win-x64 --output ../../binaries/whatsapp-sidecar-x86_64-pc-windows-msvc.exe --no-bytecode --public-packages \"*\" --public"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "express": "^4.19.2",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0"
  },
  "pkg": {
    "assets": [
      "node_modules/@whiskeysockets/baileys/**/*",
      "node_modules/@adiwajshing/keyed-db/**/*",
      "node_modules/libsignal/**/*",
      "node_modules/node-cache/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "../../binaries"
  }
}
