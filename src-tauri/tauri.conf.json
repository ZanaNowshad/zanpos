{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZANPOS",
  "version": "1.0.1",
  "identifier": "com.super.zanpos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZANPOS — Point of Sale",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/whatsapp-sidecar"
    ],
    "category": "Business",
    "copyright": "© 2025 ZANPOS. All rights reserved.",
    "shortDescription": "Offline-capable retail point-of-sale for Windows",
    "longDescription": "ZANPOS is a modern, local-first point-of-sale system built for Windows. Designed for Bahraini and Gulf retail businesses with BHD currency support, thermal receipt printing, WhatsApp notifications, AI-powered business insights, and optional Supabase cloud sync.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_REPLACE_WITH_REAL_KEY",
      "endpoints": [
        "https://releases.zanpos.app/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
