{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZANPOS",
  "version": "2.0.0",
  "identifier": "com.super.zanpos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd src-tauri/sidecar/whatsapp-sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZANPOS — Point of Sale",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http://127.0.0.1:3131 https://github.com https://*.githubusercontent.com https://quranapi.pages.dev; media-src 'self' https://github.com https://*.githubusercontent.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/whatsapp-sidecar"
    ],
    "category": "Business",
    "copyright": "© 2025 ZANPOS. All rights reserved.",
    "shortDescription": "Offline-capable retail point-of-sale for Windows",
    "longDescription": "ZANPOS is a modern, local-first point-of-sale system built for Windows. Designed for Bahraini and Gulf retail businesses with BHD currency support, thermal receipt printing, WhatsApp notifications, AI-powered business insights, and multi-terminal LAN sync.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCODBBQTMxRTZBNDhBQTUKUldTbGlxVG1NYXFBSytDckQrZ2RKNDRUem9WeFRRM2F1cDBxdlFZMG9HKzNwS2R0clRFSW5vNVEK",
      "endpoints": [
        "https://releases.zanpos.app/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
